# Copy to .env beside the compose file, then edit. .env is gitignored.

# ---------------------------------------------------------------- required
# Anyone with this can run any command on the server. Generate one:
#   openssl rand -base64 24 | tr -d '/+=' | head -c 32
BLACKMESA_SERVER_RCON_PASSWORD=

# ---------------------------------------------------------------- the server
# The name players see is set in server.cfg.
BLACKMESA_SERVER_MAX_PLAYERS=16
BLACKMESA_SERVER_START_MAP=dm_crossfire
# 0 and 0: the map never changes on its own. The shipped rotation has one
# entry, so this is a crossfire server and nothing else. For a rotating
# server, set a time limit in minutes (or a frag limit) and add maps to
# mapcycle.txt.
BLACKMESA_SERVER_TIME_LIMIT=0
BLACKMESA_SERVER_FRAG_LIMIT=0

# ---------------------------------------------------------------- networking
# Game, query and rcon port. Published on the host under the same number on
# purpose: Steam's list records the port the server BINDS, so publishing a
# different one outside hands players an address where a different server
# answers.
BLACKMESA_SERVER_PORT=27015

# ---------------------------------------------------------------- overridable defaults
# Everything below has a working default in the compose file; set it here only
# to change it, and the change survives every git pull.
#
# BLACKMESA_SERVER_IMAGE_VERSION=latest@sha256:...
# BLACKMESA_SERVER_IMAGE_TAG=lacledeslan/gamesvr-blackmesa:latest
#
# 3g is measured: a deathmatch server peaked at 865 MB. The ceiling exists so
# a leak here cannot get some other container killed instead.
# BLACKMESA_SERVER_MEMORY_LIMIT=3g
# BLACKMESA_SERVER_CPU_LIMIT=2.0
# BLACKMESA_SERVER_MEMORY_RESERVATION=512m
# BLACKMESA_SERVER_CPU_RESERVATION=0.5
#
# BLACKMESA_SERVER_START_PERIOD=4m
# BLACKMESA_SERVER_STOP_GRACE_PERIOD=30s
# BLACKMESA_SERVER_LOG_MAX_SIZE=10m
# BLACKMESA_SERVER_LOG_MAX_FILE=3

# The clock this server writes its timestamps in. Every line it logs is
# read next to one from somewhere else, and two clocks make that
# arithmetic. Any zone name from the tz database works — the image
# carries the whole of it.
# BLACKMESA_SERVER_TIMEZONE=Etc/UTC
